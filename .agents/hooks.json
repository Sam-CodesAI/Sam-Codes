{
  "safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "/workspaces/Personal-Workspace/.agents/scripts/safety_check.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "auto-formatter": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "/workspaces/Personal-Workspace/.agents/scripts/auto_format.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "/workspaces/Personal-Workspace/.agents/scripts/auto_format.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
